---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  pageClass?: string;
}

const {
  title,
  description,
  image,
  structuredData,
  pageClass = '',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image
  ? (image.startsWith('http') ? image : Astro.site ? new URL(image, Astro.site).href : undefined)
  : undefined;
const jsonLd = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData])
  : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173c33" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      (() => {
        const KEY = 'psm-consent-v1';
        const GA_ID = 'G-HXM22WWPKP';
        const defaults = { analytics: false, preferences: false, marketing: false };
        const read = () => {
          try { return { ...defaults, ...JSON.parse(localStorage.getItem(KEY) || '{}') }; }
          catch { return defaults; }
        };
        const loadAnalytics = () => {
          if (window.__psmGaLoaded) return;
          window.__psmGaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_ID, { anonymize_ip: true });
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
          document.head.appendChild(script);
        };
        window.psmConsent = {
          key: KEY,
          read,
          save(next) {
            localStorage.setItem(KEY, JSON.stringify({ ...defaults, ...next }));
            window.dispatchEvent(new CustomEvent('psm-consent-changed'));
          }
        };
        if (read().analytics) loadAnalytics();
        window.addEventListener('psm-consent-changed', () => {
          if (read().analytics) loadAnalytics();
        });
      })();
    </script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" data-header>
      <div class="shell header-inner">
        <Logo />
        <nav class="main-nav" aria-label="Navegación principal">
          <a href="/#historia">Historia</a>
          <a href="/#visita">Visita</a>
          <a href="/#como-llegar">Cómo llegar</a>
          <a href="/#alrededores">Alrededores</a>
          <a href="/#preguntas">Preguntas</a>
        </nav>
        <a class="header-cta" href="/#mapa">Ver mapa</a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <Logo />
          <p>Guía cultural independiente para comprender y recorrer el corazón histórico de Córdoba.</p>
        </div>
        <div>
          <h2>Información</h2>
          <a href="/#visita">Planificar la visita</a>
          <a href="/#como-llegar">Transporte</a>
          <a href="/#servicios">Servicios útiles</a>
          <a href="/#fuentes">Fuentes y método</a>
        </div>
        <div>
          <h2>Legal</h2>
          <a href="/privacidad/">Política de privacidad</a>
          <a href="/terminos/">Términos de servicio</a>
          <a href="/cookies/">Configuración de cookies</a>
        </div>
      </div>
      <div class="shell footer-notes">
        <p><strong>Proyecto independiente y sin fines de lucro.</strong> Este sitio no pertenece ni está afiliado a la Municipalidad de Córdoba, al Gobierno de la Provincia de Córdoba ni a organismos oficiales de la República Argentina.</p>
        <p>La información patrimonial y turística se contrasta con material público de la Municipalidad de Córdoba —incluidas sus áreas de Turismo y Cultura—, la Agencia Córdoba Turismo y la Secretaría de Turismo, Ambiente y Deportes de la Nación. No contiene recomendaciones comerciales pagadas.</p>
        <p>Derechos de imagen: las fotografías conservan la autoría, licencia y derechos indicados por cada fotógrafo o repositorio. Las imágenes de Wikimedia Commons se utilizan conforme a sus licencias individuales.</p>
        <p>© 2026 Guía Plaza San Martín Córdoba. Todos los derechos reservados sobre el diseño y los contenidos originales.</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const header = document.querySelector('[data-header]');
        const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 18);
        update();
        window.addEventListener('scroll', update, { passive: true });
      })();
    </script>
  </body>
</html>
