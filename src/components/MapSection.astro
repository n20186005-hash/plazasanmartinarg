---
import { GOOGLE_MAPS_EMBED } from '../data/site';

interface Props {
  title?: string;
  caption?: string;
}

const {
  title = 'Mapa de Plaza San Martín, Córdoba',
  caption = 'Dirección de referencia: X5000 Córdoba, Provincia de Córdoba, Argentina. Perímetro: 27 de Abril, Buenos Aires, Independencia y Rosario de Santa Fe. El mapa externo puede mostrar información dinámica.',
} = Astro.props;
---

<div class="map-wrap" data-map-root>
  <div class="map-consent" data-map-consent>
    <div class="map-consent-inner">
      <h3>Cargar mapa interactivo</h3>
      <p>Google Maps es un servicio de terceros y puede utilizar cookies o tecnologías similares. Al cargarlo, aceptás esa conexión para esta función.</p>
      <button class="button button-light" type="button" data-load-map>Cargar Google Maps</button>
      <p data-map-status role="status" aria-live="polite"></p>
      <p><a href="/privacidad/">Cómo tratamos los servicios de terceros</a></p>
    </div>
  </div>
  <template data-map-template>
    <iframe src={GOOGLE_MAPS_EMBED} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title={title}></iframe>
  </template>
</div>
<p class="map-caption">{caption}</p>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-map-root]');
    if (!root) return;
    const consent = root.querySelector('[data-map-consent]');
    const template = root.querySelector('[data-map-template]');
    const load = () => {
      if (root.querySelector('iframe') || !template) return;
      root.appendChild(template.content.cloneNode(true));
      if (consent) consent.hidden = true;
    };
    window.addEventListener('psm-consent-changed', () => {
      if (window.psmConsent?.read?.().preferences) load();
      else { root.querySelector('iframe')?.remove(); if (consent) consent.hidden = false; }
    });
    const preferences = window.psmConsent?.read?.();
    if (preferences?.preferences) load();
    root.querySelector('[data-load-map]')?.addEventListener('click', () => {
      const current = window.psmConsent?.read?.() || {};
      const result = window.psmConsent?.save?.({ ...current, preferences: true });
      if (result?.choice.preferences) load();
      else {
        const message = root.querySelector('[data-map-status]');
        if (message) message.textContent = result?.message || 'No se pudo confirmar el permiso para cargar el mapa.';
      }
    });
  })();
</script>
