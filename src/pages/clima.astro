---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import WeatherPlanning from '../components/WeatherPlanning.astro';

const base = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://plazasanmartinarg.com';
const here = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const faq = [
  { q: '¿El pronóstico mide el tiempo dentro de la plaza?', a: 'No. Es una estimación de Open-Meteo para las coordenadas de la plaza en Córdoba, Argentina. No es una estación meteorológica instalada allí ni un servicio de alertas.' },
  { q: '¿Cuándo se actualiza el pronóstico?', a: 'La página consulta el pronóstico al abrirse. La respuesta puede reutilizarse durante unos diez minutos. Mostramos la hora de consulta en hora de Córdoba; eso no equivale a la hora de una observación local.' },
  { q: '¿La probabilidad de lluvia garantiza que va a llover?', a: 'No. Es una estimación que puede cambiar. Consultá las alertas del Servicio Meteorológico Nacional y las condiciones del día antes de decidir el paseo.' },
  { q: '¿Qué ropa llevo?', a: 'Decidí según la temperatura, el viento y la lluvia previstos. Llevá capas si cambia la temperatura, agua y protección solar si hace calor, y reconsiderá el paseo si hay una alerta o tormenta.' },
  { q: '¿Qué hago si no aparece el clima?', a: 'Si no podemos cargar datos válidos, mostramos un aviso de indisponibilidad en lugar de cifras antiguas. Consultá el Servicio Meteorológico Nacional y volvé a intentarlo más tarde.' }
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: base + '/' },
    { '@type': 'ListItem', position: 2, name: 'Clima de Plaza San Martín', item: here }
  ]
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<BaseLayout
  title="Clima en Plaza San Martín Córdoba: pronóstico para tu paseo"
  description="Pronóstico para Plaza San Martín en Córdoba, Argentina: temperatura, lluvia, viento y orientación para preparar el paseo. Consultá también las alertas oficiales."
  structuredData={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="shell">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li>Clima</li>
      </ol>
    </nav>

    <header class="subpage-hero">
      <span class="eyebrow">Clima y temporada</span>
      <h1>Clima en Plaza San Martín (Córdoba)</h1>
      <p class="lede">Consultá la estimación para las coordenadas de la plaza y ajustá el paseo al tiempo del día. El pronóstico no garantiza condiciones ni sustituye las alertas oficiales.</p>
    </header>
  </div>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div><span class="section-kicker">Antes de salir</span><h2>Qué llevar y cuándo reconsiderar el paseo</h2></div>
        <p class="section-intro">Usá estas orientaciones junto al pronóstico del módulo siguiente. Las condiciones pueden cambiar durante la visita.</p>
      </div>
      <WeatherPlanning />
    </div>
  </section>

  <WeatherSection />

  <section id="preguntas" class="section section-sand">
    <div class="shell">
      <div class="section-head">
        <div><span class="section-kicker">Preguntas frecuentes</span><h2>Clima en pocas preguntas</h2></div>
        <p class="section-intro">Respuestas sobre la fuente, la actualización, la lluvia y los datos no disponibles.</p>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="related">
    <div class="shell">
      <h2 class="block-title">Seguir explorando</h2>
      <div class="related-grid">
        <a class="related-card" href="/historia/"><span>Historia</span><strong>Desde 1577 hasta hoy</strong></a>
        <a class="related-card" href="/ubicacion/"><span>Ubicación</span><strong>Dónde está y cómo llegar</strong></a>
        <a class="related-card" href="/"><span>Inicio</span><strong>Guía completa de visita</strong></a>
      </div>
    </div>
  </section>
</BaseLayout>
